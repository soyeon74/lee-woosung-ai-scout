# Example configuration only — never add actual credentials to Git.
# Copy to .env for local backend development and replace placeholder values.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
DATA_ADMIN_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
# Set to an absolute local path to the Firebase service-account file.
# On Render, use the Secret File path (e.g. /etc/secrets/firebase-service-account.json).
GOOGLE_APPLICATION_CREDENTIALS=PATH_TO_YOUR_FIREBASE_SERVICE_ACCOUNT_JSON
# Allow only explicitly trusted browser origins, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://lee-woosung-ai-scout-iota.vercel.app
